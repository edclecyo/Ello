rules_version = '2';
service firebase.storage {
 match /b/{bucket}/o {
   match /capsules/{capsuleId}/{ownerId}/{fileName} {
     allow write: if request.auth != null && request.auth.uid == ownerId
       && request.resource.size < 50 * 1024 * 1024
       && request.resource.contentType.matches('(image|video|audio)/.*');
     // Storage URLs must not be exposed in capsulePublic.
     // Access is authenticated; Firestore controls when URLs are revealed.
     allow read: if request.auth != null;
   }
 }
}
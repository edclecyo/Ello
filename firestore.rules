rules_version = '2';
service cloud.firestore { match /databases/{database}/documents {
 function signed(){return request.auth != null;}
 function owner(data){return signed() && request.auth.uid == data.ownerId;}
 function openNow(data){return request.time >= timestamp.value(data.openAt);}
 match /capsules/{id} {
  // Criação é exclusiva da Cloud Function finalizeCapsule.
  allow create: if false;
  allow read: if owner(resource.data) || (signed() && openNow(resource.data));
  // O dono pode alterar apenas estado de abertura; plano/owner/mídia não podem ser promovidos pelo cliente.
  allow update: if owner(resource.data)
    && request.resource.data.ownerId == resource.data.ownerId
    && request.resource.data.experiencePlan == resource.data.experiencePlan
    && request.resource.data.media == resource.data.media
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','openedAt']);
  allow delete: if owner(resource.data);
  match /reactions/{rid} {allow create: if signed(); allow read: if signed() && get(/databases/$(database)/documents/capsules/$(id)).data.ownerId == request.auth.uid;}
 }
 match /capsulePublic/{id} {
  allow read: if true;
  // Metadados públicos também são criados somente pelo servidor.
  allow create,update: if false;
  allow delete: if signed() && resource.data.ownerId == request.auth.uid;
 }
 match /users/{uid} {
  allow read: if signed() && request.auth.uid == uid;
  // Créditos e compras são controlados pelas Cloud Functions.
  allow write: if false;
  match /aiTransactions/{id} {allow read: if signed() && request.auth.uid == uid; allow write: if false;}
  match /experiencePurchases/{id} {allow read: if signed() && request.auth.uid == uid; allow write: if false;}
 }
 match /payments/{id} {allow read,write: if false;}
 match /experiencePayments/{id} {allow read,write: if false;}
}}
